# Copie para .env (na raiz do repo ou em backend/, que tem prioridade) e preencha.
# Nunca commite o .env.

ANTHROPIC_API_KEY=

# Padrões dos Ajustes: a aba Ajustes sobrescreve e guarda no banco.
# MODEL_WRITER=claude-sonnet-5-5
# MODEL_TRIAGE=claude-haiku-5-5
# VIDEO_ENCODER=auto   # auto | h264_amf | libx264

# Login no YouTube para vídeos com restrição de idade: o yt-dlp usa os cookies do
# navegador onde você entrou no YouTube (de preferência uma conta secundária).
# "firefox" usa o perfil padrão; "firefox:NomeDoPerfil" escolhe outro.
# YTDLP_COOKIES_FROM_BROWSER=firefox

# Padrões do Radar: a aba Radar sobrescreve.
# RADAR_INTERVAL_MINUTES=30
# RADAR_DAILY_LIMIT=10

# Pasta de dados (banco, vídeos, cortes, molduras). Padrão: <repo>/data
# DATA_DIR=
